import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import OnboardingStepper from './OnboardingStepper';

// These match the DEFAULT_CATEGORIES the backend auto-creates on /auth/register,
// so every option shown here already exists server-side for this user.
const CATEGORIES = [
  { name: 'Food',          icon: 'restaurant' },
  { name: 'Travel',        icon: 'directions_car' },
  { name: 'Bills',         icon: 'bolt' },
  { name: 'Shopping',      icon: 'shopping_bag' },
  { name: 'Education',     icon: 'school' },
  { name: 'Medical',       icon: 'medical_services' },
  { name: 'Entertainment', icon: 'movie' },
  { name: 'Other',         icon: 'category' },
];

export default function OnboardingCategories() {
  const [selected, setSelected] = useState(new Set(['Food', 'Travel', 'Bills', 'Shopping']));
  const navigate = useNavigate();

  const toggle = (name) => {
    setSelected(prev => {
      const next = new Set(prev);
      next.has(name) ? next.delete(name) : next.add(name);
      return next;
    });
  };

  const canContinue = selected.size >= 3;

  const handleContinue = () => {
    sessionStorage.setItem('onboarding_categories', JSON.stringify([...selected]));
    navigate('/onboarding/budget');
  };

  return (
    <div className="dark bg-[#0A0A0C] text-on-surface font-body-md antialiased min-h-screen flex flex-col items-center pt-12 pb-16 px-6">
      <div className="w-full max-w-2xl">
        <OnboardingStepper step={1} />

        <section className="mb-10 text-center md:text-left">
          <h1 className="font-display-lg text-headline-lg-mobile md:text-display-lg text-on-surface mb-3">
            Choose your categories
          </h1>
          <p className="text-on-surface-variant text-body-md">
            Pick at least 3 to set up budgets for on the next step. You can track any category later — this just decides what we ask you to budget for now.
          </p>
        </section>

        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
          {CATEGORIES.map(({ name, icon }) => {
            const isSel = selected.has(name);
            return (
              <button
                key={name}
                onClick={() => toggle(name)}
                className={`group flex flex-col items-center justify-center p-6 rounded-xl border relative overflow-hidden transition-all ${
                  isSel
                    ? 'bg-secondary-container/20 border-secondary/50 shadow-[0_0_20px_rgba(192,192,192,0.1)]'
                    : 'bg-surface-container border-white/10 hover:border-white/25'
                }`}
              >
                <span
                  className={`material-symbols-outlined text-3xl mb-3 ${isSel ? 'text-secondary' : 'text-on-surface-variant'}`}
                  style={{ fontVariationSettings: `'FILL' ${isSel ? 1 : 0}` }}
                >
                  {icon}
                </span>
                <span className="text-sm font-medium text-on-surface">{name}</span>
                {isSel && (
                  <div className="absolute top-2 right-2">
                    <span className="material-symbols-outlined text-[16px] text-secondary" style={{ fontVariationSettings: "'FILL' 1" }}>
                      check_circle
                    </span>
                  </div>
                )}
              </button>
            );
          })}
        </div>

        <div className="flex items-center justify-between">
          <span className="text-xs text-on-surface-variant">{selected.size} selected {!canContinue && '(min. 3)'}</span>
          <button
            onClick={handleContinue}
            disabled={!canContinue}
            className="bg-primary text-black px-8 py-3.5 rounded-full font-label-sm text-label-sm uppercase tracking-widest shadow-[0_0_15px_rgba(255,255,255,0.15)] hover:shadow-[0_0_25px_rgba(255,255,255,0.25)] transition-all disabled:opacity-40 disabled:cursor-not-allowed disabled:shadow-none flex items-center gap-2"
          >
            Continue
            <span className="material-symbols-outlined text-[16px]">arrow_forward</span>
          </button>
        </div>
      </div>
    </div>
  );
}
