import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import API from '../../services/api';
import OnboardingStepper from './OnboardingStepper';

const DEFAULT_LIMITS = {
  Food: 8000, Travel: 5000, Bills: 6000, Shopping: 5000,
  Education: 4000, Medical: 3000, Entertainment: 3000, Other: 2000,
};
const MAX_LIMITS = {
  Food: 30000, Travel: 30000, Bills: 30000, Shopping: 30000,
  Education: 30000, Medical: 30000, Entertainment: 30000, Other: 30000,
};

const fmt = n => '₹' + Number(n).toLocaleString('en-IN', { maximumFractionDigits: 0 });

export default function OnboardingBudget() {
  const categories = JSON.parse(sessionStorage.getItem('onboarding_categories') || '[]');
  const [limits, setLimits] = useState(
    Object.fromEntries(categories.map(c => [c, DEFAULT_LIMITS[c] || 3000]))
  );
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');
  const navigate = useNavigate();

  const setLimit = (cat, val) => setLimits(l => ({ ...l, [cat]: Number(val) }));

  const total = Object.values(limits).reduce((a, b) => a + b, 0);
  const month = new Date().toISOString().slice(0, 7);

  const handleContinue = async () => {
    setSaving(true); setError('');
    try {
      await Promise.all(
        categories.map(category =>
          API.post('/budget/set', { category, month, limit_amount: limits[category] })
        )
      );
      sessionStorage.setItem('onboarding_budget_total', String(total));
      navigate('/onboarding/loading');
    } catch {
      setError('Could not save one or more budgets. You can adjust these later on the Health & Budget page.');
      setSaving(false);
    }
  };

  if (categories.length === 0) {
    return (
      <div className="dark bg-[#0A0A0C] text-on-surface min-h-screen flex flex-col items-center justify-center gap-4 px-6">
        <p className="text-on-surface-variant text-sm">No categories selected yet.</p>
        <button
          onClick={() => navigate('/onboarding/categories')}
          className="text-primary text-sm underline"
        >
          Go back and choose categories
        </button>
      </div>
    );
  }

  return (
    <div className="dark bg-[#0A0A0C] text-on-surface font-body-md antialiased min-h-screen flex flex-col items-center pt-12 pb-24 px-6">
      <div className="w-full max-w-2xl">
        <OnboardingStepper step={2} />

        <section className="mb-8 text-center md:text-left">
          <h1 className="font-display-lg text-headline-lg-mobile md:text-display-lg text-on-surface mb-3">
            Set monthly budgets
          </h1>
          <p className="text-on-surface-variant text-body-md">
            Drag each slider or type an exact number. These become your Category Thresholds on the Health &amp; Budget page — you can change them any time.
          </p>
        </section>

        <div className="flex flex-col gap-6 mb-8">
          {categories.map(cat => (
            <div key={cat} className="bg-surface-container rounded-xl p-6 border border-white/10">
              <div className="flex justify-between items-center mb-3">
                <span className="font-medium text-on-surface">{cat}</span>
                <input
                  type="number"
                  value={limits[cat]}
                  onChange={e => setLimit(cat, e.target.value)}
                  className="bg-surface-container-lowest border border-white/10 rounded-md px-3 py-2 text-on-surface text-sm w-28 text-right focus:outline-none focus:border-primary transition-colors"
                />
              </div>
              <input
                type="range"
                min={0}
                max={MAX_LIMITS[cat] || 30000}
                step={100}
                value={limits[cat]}
                onChange={e => setLimit(cat, e.target.value)}
                className="w-full accent-white"
              />
            </div>
          ))}
        </div>

        <div className="bg-surface-container-low rounded-xl p-5 border border-white/10 flex justify-between items-center mb-6">
          <span className="text-sm text-on-surface-variant uppercase tracking-widest">Total Monthly Budget</span>
          <span className="text-xl font-semibold text-primary">{fmt(total)}</span>
        </div>

        {error && (
          <div className="text-sm px-4 py-3 rounded-lg border border-error/30 bg-error-container/20 text-error mb-6">
            {error}
          </div>
        )}

        <div className="flex items-center justify-between">
          <button
            onClick={() => navigate('/onboarding/categories')}
            className="text-on-surface-variant text-sm hover:text-on-surface transition-colors"
          >
            ← Back
          </button>
          <button
            onClick={handleContinue}
            disabled={saving}
            className="bg-primary text-black px-8 py-3.5 rounded-full font-label-sm text-label-sm uppercase tracking-widest shadow-[0_0_15px_rgba(255,255,255,0.15)] hover:shadow-[0_0_25px_rgba(255,255,255,0.25)] transition-all disabled:opacity-50 flex items-center gap-2"
          >
            {saving ? 'Saving...' : 'Continue'}
            {!saving && <span className="material-symbols-outlined text-[16px]">arrow_forward</span>}
          </button>
        </div>
      </div>
    </div>
  );
}
